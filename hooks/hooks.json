{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.js",
              "session-start"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.js",
              "prompt-submit"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.js",
              "pre-tool"
            ]
          }
        ]
      },
      {
        "matcher": "mcp__.+__(save_.+|create_.+|delete_.+|share_issue|unshare_issue|merge_diff|submit_diff_review|resolve_diff_thread|update_diff|mark_notification|retire_.+|restore_.+|prepare_.+)",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.js",
              "pre-tool"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Artifact|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.js",
              "post-tool"
            ]
          }
        ]
      },
      {
        "matcher": "mcp__.+__get_workspace",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/run.js",
              "post-tool"
            ]
          }
        ]
      }
    ]
  }
}
